# Application Settings
APP_NAME="Geoportal Chile - CBERS-4A"
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# STAC API configuration
# INPE STAC API / Brazil Data Cube
STAC_API_URL="https://brazildatacube.dpi.inpe.br/stac/"
# BDC access token if required (often needed for Brazil Data Cube STAC)
BDC_ACCESS_TOKEN=""

# Alternative AWS Element84 STAC
# STAC_API_URL="https://earth-search.aws.element84.com/v1"

# AWS Configuration (for reading S3 COGs)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
# For public S3 buckets, set to True to avoid needing credentials
AWS_NO_SIGN_REQUEST=True

# GDAL performance tuning for COG access
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
GDAL_HTTP_MERGE_CONSECUTIVE_PARTS=YES
GDAL_NUM_THREADS=ALL_CPUS
VSI_CACHE=TRUE
VSI_CACHE_SIZE=50000000
